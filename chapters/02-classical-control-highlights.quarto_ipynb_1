    "import numpy as np\n",
    "import scipy.signal as signal\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# System parameters\n",
    "zeta = [0.1, 0.3, 0.5, 0.7, 0.9]\n",
    "wn = 4\n",
    "\n",
    "# Create a figure\n",
    "plt.figure(figsize=(10, 6))\n",
    "t = np.linspace(0, 10, 1000)\n",
    "for i, z in enumerate(zeta):\n",
    "    # Transfer function coefficients\n",
    "    num = [wn**2]\n",
    "    den = [1, 2*z*wn, wn**2]\n",
    "    \n",
    "    sys = signal.TransferFunction(num, den)\n",
    "    \n",
    "    # Compute step response over our defined timeline\n",
    "    t_out, y = signal.step(sys, T=t)\n",
    "\n",
    "    # Plot step response\n",
    "    plt.plot(t_out, y, label=f'ζ = {z}')\n",
    "\n",
    "plt.xlabel('Time (s)')\n",
    "plt.ylabel('Response')\n",
    "plt.title('Step Response of MSD System')\n",
    "plt.legend()\n",
    "plt.grid(True)\n",
    "plt.show()"
   ]
