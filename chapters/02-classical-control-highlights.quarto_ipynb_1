    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import control as ct\n",
    "\n",
    "# Define the transfer function: G(s) = (s+2)(s^2+s+5) / (s(s+5)(s^2+5s+15))\n",
    "num = np.polymul([1, 2], [1, 1, 5])\n",
    "den = np.polymul([1, 0], np.polymul([1, 5], np.polymul([1, 5, 15], [1, 5, 15])))\n",
    "G = ct.TransferFunction(num, den)\n",
    "\n",
    "# Plot the poles and zeros\n",
    "plt.figure()\n",
    "ct.pole_zero_plot(G, title='Poles and Zeros of G(s)', grid=True)\n",
    "plt.show()"
