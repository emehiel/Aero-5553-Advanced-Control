      "source": [
        "import numpy as np\n",
        "import scipy.linalg as la\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Mass Matrtix\n",
        "m_1 = 1.0\n",
        "m_2 = 1.0\n",
        "M = np.array([[m_1, 0], [0, m_2]])\n",
        "\n",
        "# Stiffness Matrix\n",
        "k_1 = 1\n",
        "k_2 = 1\n",
        "K = np.array([[k_1 + k_2, -k_2], [-k_2, k_1 + k_2]])\n",
        "\n",
        "# Step 1 - Compute the Modal Matrix\n",
        "P = la.sqrtm(la.inv(M)) @ K @ la.sqrtm(la.inv(M))\n",
        "\n",
        "# Step 2 - Compute the Eigenvalues and Eigenvectors of P\n",
        "Lambda, Psi_bar = la.eig(P)\n",
        "\n",
        "# Step 3 - Compute the Mode Shapes\n",
        "Psi_0 = la.sqrtm(la.inv(M)) @ Psi_bar\n",
        "\n",
        "print(\"Eigenvalues (Mode Frequencies):\")\n",
        "print(Lambda)\n",
        "\n",
        "print(\"Mode Shapes:\")\n",
        "print(Psi_0)"
      ],
